{
  // Cloudflare Workers 설정. 정적 파일(public/)과 API 서버(src/)를 한 Worker에서 함께 서비스합니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minigames",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // public/ 아래 파일은 정적 자산으로 그대로 서비스됩니다.
  // run_worker_first에 적힌 경로만 Worker 코드가 먼저 처리합니다(= API).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/game/*", "/ad/*", "/user/*"]
  },

  // D1 데이터베이스 (APAC 리전). 스키마는 migrations/ 에 있습니다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minigames-db",
      "database_id": "c2d77540-5648-4c74-ad4f-00de5bc01e9f"
    }
  ],

  // 광고 동작 모드. "mock" = 목업 광고, "live" = 실제 광고 플랫폼 검증 사용.
  // 실연동 전에 "live" 로 바꾸면 src/lib/adverify.js 가 501 로 실패합니다(의도된 안전장치).
  //
  // ENV_NAME 은 **테스트 모드 잠금**입니다. "production" 이면 TEST_MODE 를 켜도
  // 아무 일도 일어나지 않습니다 — 하루 한도들은 어뷰징 방어라 프로덕션에서 풀리면
  // 안 됩니다(src/lib/testmode.js). 이 줄을 지우지 마세요.
  "vars": {
    "AD_MODE": "mock",
    "ENV_NAME": "production"
  },

  // SESSION_SECRET 은 시크릿이므로 이 파일에 두지 않습니다.
  //   npx wrangler versions secret put SESSION_SECRET

  // 오래된 세션 행 정리 (src/index.js 의 scheduled 핸들러).
  // 세션은 문제를 푸는 동안만 필요한 임시 상태인데, 지우지 않으면 사용량에 비례해
  // 무한히 쌓여 D1 용량 상한(10GB)에 걸립니다. 게임 기록은 results 에 남습니다.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // ── 스테이징 (외부 테스터용) ──────────────────────────────────────────────
  //
  // 별개의 Worker 이고 **별개의 D1** 입니다. 테스터의 기록이 실서비스 순위·통계에
  // 섞이지 않고, 하루 한도가 풀려 있어도 실서비스 어뷰징 방어에는 영향이 없습니다.
  //
  //   배포:  npx wrangler deploy --env staging
  //   주소:  https://minigames-staging.<계정>.workers.dev
  //
  // main push 는 Workers Builds 가 **프로덕션만** 빌드합니다. 스테이징은 이 명령이
  // 유일한 배포 경로라, CLAUDE.md 의 「wrangler deploy 직접 실행 금지」(프로덕션에
  // 버전이 두 개 생기는 것을 막는 규칙)에 걸리지 않습니다.
  //
  // Cron 은 두지 않습니다 — 세션 정리는 테스트 규모에서 필요 없고, ⑮ 의 자정 이월이
  // 두 환경에서 각자 돌 이유가 없습니다.
  //
  // 처음 한 번:
  //   npx wrangler d1 create minigames-staging-db     → 나온 id 를 아래에 넣습니다
  //   npx wrangler d1 migrations apply minigames-staging-db --remote --env staging
  //   npx wrangler versions secret put SESSION_SECRET --env staging
  "env": {
    "staging": {
      "name": "minigames-staging",
      "vars": {
        "AD_MODE": "mock",
        "ENV_NAME": "staging",
        "TEST_MODE": "on"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "minigames-staging-db",
          "database_id": "TODO-스테이징-D1-생성-후-교체"
        }
      ]
    }
  }
}
