{
  // Cloudflare Workers 설정. 정적 파일(public/)과 API 서버(src/)를 한 Worker에서 함께 서비스합니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minigames",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // public/ 아래 파일은 정적 자산으로 그대로 서비스됩니다.
  // run_worker_first에 적힌 경로만 Worker 코드가 먼저 처리합니다(= API).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // `/api/*` 는 스위트(타로·사주·심리)용입니다. 넣지 않으면 정적 자산 핸들러가
    // 먼저 가로채 404 를 돌려줍니다 — API 가 통째로 죽는데 배포는 성공합니다.
    //
    // `/webtoon/w/*` 는 회차 그림입니다. Worker 가 먼저 받아 **R2 에서** 내보냅니다 —
    // 회차를 올리는 일과 코드를 배포하는 일을 떼어 놓기 위해서입니다(인수인계 C-2).
    // R2 에 없으면 정적 자산으로 넘겨주므로, 옮기는 중에도 끊기지 않습니다.
    // `/ys/*` 는 너의스토리입니다. 두 갈래가 들어 있습니다 —
    // `/ys/a/*` 결과 그림(소유자 확인 후 R2 서빙) · `/ys/w/*` PC 워커 브리지.
    // 화면 파일은 `public/webtoon/yourstory/` 라 이 목록과 겹치지 않습니다.
    "run_worker_first": ["/game/*", "/ad/*", "/user/*", "/api/*", "/webtoon/w/*", "/ys/*"]
  },

  // D1 데이터베이스 (APAC 리전). 스키마는 migrations/ 에 있습니다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minigames-db",
      "database_id": "c2d77540-5648-4c74-ad4f-00de5bc01e9f"
    }
  ],

  // 회차 그림 저장소. 콘텐츠와 코드를 떼어 놓는 것이 목적이라 **환경별로 다른
  // 버킷**입니다 — 스테이징에 시험 삼아 올린 회차가 실서비스에 보이면 안 됩니다.
  // 너의스토리 결과물은 **다른 버킷**입니다(`YS`). 연재 회차는 전원 공개에 1년
  // immutable 캐시인데 이쪽은 한 사람의 이야기라 기본 비공개입니다 — 같은 버킷에
  // 두면 캐시 규칙 한 줄 잘못 건드렸을 때 남의 이야기가 공개됩니다.
  //
  // 이름 뒤의 `-apac` 은 **리전**입니다. 처음 만든 `webtoon-assets` 는 ENAM(북미)
  // 이었는데, 이용자는 한국이고 D1·`YS` 는 APAC(ICN) 입니다. workers.dev 는 엣지
  // 캐시를 쓰지 않으므로(응답에 `cf-cache-status` 가 없습니다) 1년 immutable 캐시는
  // 브라우저에만 걸리고 **각 이용자의 첫 요청은 매번 태평양을 건넜습니다.**
  // R2 는 만든 뒤 리전을 못 바꿔 새 버킷으로 옮겼습니다(2026-08-20). 옛 버킷은
  // 이름이 그대로 남아 있으니, 되돌리려면 이 두 줄에서 `-apac` 만 지웁니다.
  "r2_buckets": [
    {
      "binding": "WEBTOON",
      "bucket_name": "webtoon-assets-apac"
    },
    {
      "binding": "YS",
      "bucket_name": "yourstory-assets"
    }
  ],

  // 광고 동작 모드. "mock" = 목업 광고, "live" = 실제 광고 플랫폼 검증 사용.
  // 실연동 전에 "live" 로 바꾸면 src/lib/adverify.js 가 501 로 실패합니다(의도된 안전장치).
  //
  // ENV_NAME 은 **테스트 모드 잠금**입니다. "production" 이면 TEST_MODE 를 켜도
  // 아무 일도 일어나지 않습니다 — 하루 한도들은 어뷰징 방어라 프로덕션에서 풀리면
  // 안 됩니다(src/lib/testmode.js). 이 줄을 지우지 마세요.
  "vars": {
    "AD_MODE": "mock",
    "ENV_NAME": "production"
  },

  // SESSION_SECRET 은 시크릿이므로 이 파일에 두지 않습니다.
  //   npx wrangler versions secret put SESSION_SECRET
  //
  // YS_WORKER_SECRET 은 **PC 워커 브리지의 유일한 인증 수단**입니다(`/ys/w/*`).
  // 이 값이 새면 남이 대기열을 집어가 고객의 원문을 읽을 수 있습니다.
  //   npx wrangler versions secret put YS_WORKER_SECRET
  // PC 쪽은 `webtoons/config/.env` 의 같은 이름 항목에 넣습니다.

  // 오래된 세션 행 정리 (src/index.js 의 scheduled 핸들러).
  // 세션은 문제를 푸는 동안만 필요한 임시 상태인데, 지우지 않으면 사용량에 비례해
  // 무한히 쌓여 D1 용량 상한(10GB)에 걸립니다. 게임 기록은 results 에 남습니다.
  // 두 갈래다. 청소는 10분마다면 충분하지만, 너의스토리 워커 감시는 그 간격이
  // 곧 탐지 지연이라 매분 돈다(`scheduled` 가 event.cron 으로 갈라 청소를 매분
  // 돌리지 않는다 — 그러면 D1 쓰기가 10배가 된다).
  "triggers": {
    "crons": ["*/10 * * * *", "* * * * *"]
  },

  "observability": {
    "enabled": true
  },

  // ── 스테이징 (외부 테스터용) ──────────────────────────────────────────────
  //
  // 별개의 Worker 이고 **별개의 D1** 입니다. 테스터의 기록이 실서비스 순위·통계에
  // 섞이지 않고, 하루 한도가 풀려 있어도 실서비스 어뷰징 방어에는 영향이 없습니다.
  //
  //   배포:  npx wrangler deploy --env staging
  //   주소:  https://minigames-staging.<계정>.workers.dev
  //
  // main push 는 Workers Builds 가 **프로덕션만** 빌드합니다. 스테이징은 이 명령이
  // 유일한 배포 경로라, CLAUDE.md 의 「wrangler deploy 직접 실행 금지」(프로덕션에
  // 버전이 두 개 생기는 것을 막는 규칙)에 걸리지 않습니다.
  //
  // 처음 한 번 (2026-08-03 완료):
  //   npx wrangler d1 create minigames-staging-db     → 나온 id 를 아래에 넣습니다
  //   npx wrangler d1 migrations apply minigames-staging-db --remote --env staging
  //   npx wrangler versions secret put SESSION_SECRET --env staging
  //
  // `vars` 와 `d1_databases` 는 환경별로 **상속되지 않으므로** 여기에 다시 적습니다.
  // 반대로 `triggers` 는 상속되므로, Cron 을 끄려면 빈 배열을 명시해야 합니다 —
  // 테스트 빌드에 10분마다 도는 예약 작업을 영구히 달아 둘 이유가 없습니다.
  "env": {
    "staging": {
      "name": "minigames-staging",
      "workers_dev": true,
      "triggers": { "crons": [] },
      "vars": {
        "AD_MODE": "mock",
        "ENV_NAME": "staging",
        "TEST_MODE": "on"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "minigames-staging-db",
          "database_id": "bdbb8a17-0db0-4674-b8d3-9b0beaff954f"
        }
      ],
      "r2_buckets": [
        {
          "binding": "WEBTOON",
          "bucket_name": "webtoon-assets-staging-apac"
        },
        {
          "binding": "YS",
          "bucket_name": "yourstory-assets-staging"
        }
      ]
    }
  }
}
